# Copy to .env.local for local development (optional) and set the same
# variables in Vercel → Project → Settings → Environment Variables.

# Required in production. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Optional locally. Without these the API keeps data in memory.
# Adding Upstash Redis from the Vercel Marketplace sets these for you
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN, which also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
